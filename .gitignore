node_modules/
dist/
.DS_Store
*.log
# `build/*` et non `build/` : git ne descend pas dans un dossier exclu, une
# exception sur un fichier qu'il contient resterait donc sans effet.
build/*
# Les habilitations macOS décrivent ce que l'application a le droit de faire :
# c'est du source, pas un artefact de construction.
!build/entitlements.mac.plist

# Index et préférences vivent dans le répertoire de configuration système,
# jamais dans le dépôt — ils contiennent l'historique d'usage et les clés.
config.json
index.json

# Artefacts de compilation Rust.
target/

# Instantané de développement : noms de projets et volumétries réelles, produit
# localement par `npm run fixture`. Voir scripts/dev-fixture.js.
src-tauri/fixtures/

# Schémas d'autorisations régénérés par `tauri-build` à chaque compilation.
src-tauri/gen/schemas/
